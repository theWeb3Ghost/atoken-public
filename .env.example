# Token Radar — Environment Configuration Template
# Copy to .env and fill in your values.

# ---- Core ----
PORT=8080
WORKER_MODE=all                 # all | ingestion,workers,api
API_TOKEN=                      # set when exposing publicly
VPS_MODE=false                  # true on VPS: autopilot confirmed + daily digest on

MONGODB_URI=mongodb://localhost:27017/token_radar
REDIS_URL=redis://localhost:6379

# ---- DexScreener ingestion ----
DEXSCREENER_TRANSPORT=poll      # poll | ws
DEXSCREENER_WS_URL=             # only used when transport=ws
POLL_INTERVAL_MS=10000
DEXSCREENER_WS_STALE_MS=90000

# ---- Scraping (see SCRAPER PROVIDER OPTIONS below) ----
# Provider options:
#   direct              — No external service. Free, but may get IP-blocked by some sites.
#                         Best for: low-volume, clean VPS IPs, simple HTML sites.
#   cloudflare          — Your own Cloudflare Worker proxy. Free, good bypass.
#                         SCRAPER_API_KEY = your-worker-subdomain.workers.dev
#   scraperapi          — Paid service. Free tier: 1000 req/month.
#                         SCRAPER_API_KEY = your-scraperapi-key
#   scrapingbee         — Paid service. Free tier: 1000 req/month.
#                         SCRAPER_API_KEY = your-scrapingbee-key
#   webscrapingapi      — Paid service. Free tier: 100 req/day.
#                         SCRAPER_API_KEY = your-webscrapingapi-key
SCRAPER_PROVIDER=direct         # direct | cloudflare | scraperapi | scrapingbee | webscrapingapi
SCRAPER_API_KEY=
SCRAPE_TIMEOUT_MS=12000
MAX_CONCURRENT_SCRAPES=5
SCRAPER_RPM=30
MAX_RETRIES=3
RETRY_DELAY_MS=5000
MAX_QUEUE_SIZE=5000
MAX_HTML_CHARS=1500000
MAX_TEXT_CHARS=60000
RESCAN_AFTER_HOURS=0

# ---- Notifications ----
NOTIFICATION_PROVIDER=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_RATE_PER_MIN=20

# ---- LLM ----
LLM_BASE_URL=https://router.bynara.id/v1
LLM_API_KEY=
LLM_MODEL=agnes-2.5-flash
LLM_MAX_TEXT_CHARS=1200000
LLM_TIMEOUT_MS=120000
LLM_RPM=10
ANALYSIS_CONCURRENCY=1

# ---- Tracking / Learning ----
SAMPLE_ENABLED=true
SAMPLE_INTERVAL_MS=600000
SAMPLE_RPM=60
MAX_TRACKED_TOKENS=1500
TRACK_WINDOW_HOURS=72
TRACK_MIN_LIQUIDITY=1000
RUNNER_MULTIPLE=2
SAMPLE_TTL_DAYS=30

# ---- Enhancement layers ----
SEC_ENABLED=true
GT_ENABLED=true
LLM_FEATS_ENABLED=true
PAPER_MIN_SCORE=0.5
PAPER_STOP_PCT=0.30
PAPER_HORIZON_H=72

# ---- Autopilot ----
MAINTENANCE_ENABLED=true
MAINT_INTERVAL_MS=21600000
AUTO_TRAIN=true
BACKFILL_PER_RUN=40
DIGEST_ENABLED=
DEBUG=
